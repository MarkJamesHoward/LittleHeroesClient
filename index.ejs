<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <title><%- htmlWebpackPlugin.options.metadata.title %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <base href="<%- htmlWebpackPlugin.options.metadata.baseUrl2 %>" />
    <link rel="manifest" href="manifest.json" />
    <!-- imported CSS are concatenated and added automatically -->
  </head>
  <body aurelia-app="main"></body>

  <script>
    function test() {
      var node = document.querySelector("#papertest");
      console.log(node.value);
      console.log(node);
    }
  </script>

  <script>
    if ("serviceWorker" in navigator) {
      var sw = navigator.serviceWorker.register("./sw.js").then(sw => {
        console.log("registered my service worker: " + sw);
      });
    }
  </script>
</html>
