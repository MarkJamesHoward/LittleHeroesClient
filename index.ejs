<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <title><%- htmlWebpackPlugin.options.metadata.title %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <meta
      name="Description"
      content="Manage rewards for your kids based on their good behaviour"
    />
    <base href="<%- htmlWebpackPlugin.options.metadata.baseUrl2 %>" />
    <link
      href="https://fonts.googleapis.com/css?family=Fredoka+One"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css?family=Gochi+Hand"
      rel="stylesheet"
    />
    <link rel="manifest" href="/manifest.json" />
    <!-- imported CSS are concatenated and added automatically -->
  </head>
  <body aurelia-app="main"></body>

  <script>
    if ("serviceWorker" in navigator) {
      var sw = navigator.serviceWorker.register("./sw.js").then(sw => {
        console.log("registered my service worker: " + sw);
      });
    }
  </script>
</html>
