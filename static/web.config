<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
      <staticContent>
            <mimeMap fileExtension=".json" mimeType="application/json" />
             <mimeMap fileExtension=".txt" mimeType="application/text" />
     </staticContent>
    <rewrite>
      <rules>
        <rule name="SPA" stopProcessing="true">
          <match url="^(?!.*(.js|.css|.png|.jpg|.ico|.svg|.txt|.xml)).*$" />
          <conditions logicalGrouping="MatchAll">
          </conditions>
          <action type="Rewrite" url="/"  appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>