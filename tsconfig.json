{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "strict": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": false,
    "lib": ["es2022", "dom", "dom.iterable"],
    "baseUrl": "src",
    "paths": {
      "@app/*": ["app/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
